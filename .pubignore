# Files that live in the repo but must not ship to pub.dev.
#
# Note: pub gives this file precedence over .gitignore in this directory, so
# the root .gitignore entries are repeated here rather than inherited.

.dart_tool/
pubspec.lock
coverage/
.DS_Store
.vscode/

# Markdown at the repository root ships only if it is named below. Listing the
# files to exclude instead let a review document dropped next to the README go
# out with the package twice, because nobody thinks to update this file when
# writing one. The prose pages under doc/ are not affected; this matches the
# root only.
/*.md
!/README.md
!/CHANGELOG.md
!/SPEC.md

# Internal tooling.
justfile
tool/

# `dart doc` writes here. Publishing it triples the archive and pub.dev builds
# its own API documentation anyway. The prose pages under doc/ do ship.
doc/api/
